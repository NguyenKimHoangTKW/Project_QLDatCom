<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Enlink - Admin Dashboard Template</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/Areas/assets/images/logo/favicon.png">

    <!-- page css -->
    <!-- Core css -->
    <link href="~/Areas/assets/css/app.min.css" rel="stylesheet">

</head>
<body>
    <div class="app">
        <div class="layout">
            <!-- Header START -->
            @Html.Partial("_HeaderAdminPartial")
            <!-- Header END -->
            <!-- Side Nav START -->
            @Html.Partial("_SideNavPartial")
            <!-- Side Nav END -->
            <!-- Page Container START -->
            <div class="page-container">
                <!-- Content Wrapper START -->
                <div class="main-content">
                    @RenderBody();
                </div>
                <!-- Content Wrapper END -->
                <!-- Footer START -->
                @Html.Partial("_FooterAdminPartial")
                <!-- Footer END -->
            </div>
            <!-- Page Container END -->
            <!-- Search Start-->
            @Html.Partial("_SearchStartPartial")
            <!-- Search End-->
            <!-- Quick View START -->
            @Html.Partial("_QuickViewPartial")
            <!-- Quick View END -->
        </div>
    </div>


    <!-- Core Vendors JS -->
    <script src="~/Areas/assets/js/vendors.min.js"></script>

    <!-- page js -->
    <script src="~/Areas/assets/vendors/chartjs/Chart.min.js"></script>
    <script src="~/Areas/assets/js/pages/dashboard-default.js"></script>

    <!-- Core JS -->
    <script src="~/Areas/assets/js/app.min.js"></script>
    @RenderSection("scriptsAdmin", required: false)
</body>

</html>