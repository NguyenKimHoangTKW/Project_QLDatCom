@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-body">
        <div class="page-header no-gutters">
            <h2 class="text-uppercase">Quản lý đơn vị</h2>
            <hr />
            <fieldset class="border rounded-3 p-3">
                <legend class="float-none w-auto px-3">Chức năng</legend>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" style="font-size: 16px;font-weight: bold;color: #333">Lọc theo năm học</label>
                        <select class="form-control select2" id="nam-hoc">
                            <option value="0">Tất cả</option>

                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-size: 16px;font-weight: bold;color: #333">Lọc theo đơn vị chuyên môn</label>
                        <select class="form-control select2" id="chuyen-mon">
                            <option value="-1">Tất cả</option>
                            <option value="1">Đơn vị chuyên môn</option>
                        </select>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-12 d-flex flex-wrap gap-2 justify-content-start justify-content-md-end">
                        <button class="btn btn-primary" id="btnFilter">
                            <i class="fas fa-filter mr-1"></i> Lọc dữ liệu
                        </button>
                        <button class="btn btn-success" id="btnAdd">
                            <i class="fas fa-plus-circle mr-1"></i> Thêm mới
                        </button>
                        <button class="btn btn-warning text-white" id="exportExcel" data-toggle="modal" data-target="#importExcelModal">
                            <i class="fas fa-file-import mr-1"></i> Import từ Excel
                        </button>
                    </div>
                </div>

            </fieldset>
        </div>
        <hr />
        <!--Modal-->
        <div class="modal fade" id="bd-example-modal-lg">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title h4"></h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <i class="anticon anticon-close"></i>
                        </button>
                    </div>
                    <div class="modal-body" id="body-content">
                        <form id="form-validation">
                            <div class="form-group row">
                                <label class="col-sm-2 col-form-label control-label">Tên nhóm thực đơn</label>
                                <div class="col-sm-10">
                                    <input type="text" class="form-control" id="ten-nhom-menu" autocomplete="off" placeholder="Nhập tên nhóm ... *">
                                </div>
                            </div>                                               
                        </form>
                        <div class="modal-footer">
                            <!---->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--End Modal-->

        <div class="m-t-25">
            <div class="table-responsive">
                <table class="table table-bordered" id="GroupMenuTable">
                    <!--data-->
                    <thead></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section scriptsAdmin{
    <script src="~/Areas/Admin/ScriptsAdmin/GroupMenu.js"></script>
}